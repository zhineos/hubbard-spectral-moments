# --- Results: generated by the scripts, never committed (folder kept via .gitkeep) ---
/results/*
!/results/.gitkeep

# --- Research notebooks: private working notes, not part of the repository ---
/research_notebooks/

# --- Manuscript: not public yet (folder kept via .gitkeep) ---
/manuscript/*
!/manuscript/.gitkeep

# --- Generated outputs: regenerate from source (LaTeX / Python scripts) ---
*.pdf
*.dat
*.npy
*.npz
*.png
*.jpg
*.jpeg
*.eps
*.svg

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.nav
*.snm
*.vrb

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Environments, editors, OS ---
.venv/
.claude/
.DS_Store
/analytic_studies/
